# Local / deploy
PYTHON_BIN=python
BACKEND_URL=http://localhost:8000

# OpenRouter — script generation + TTS (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_TTS_MODEL=

# Fallback TTS if OpenRouter's /api/v1/audio/speech doesn't check out in the
# first 10 minutes (see PLAN.md "De-risking the 2-hour clock") — proven working
# in a related project, same shape as ELEVENLABS_VOICE_ID there.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Dokploy (do not commit real values)
DOKPLOY_BASE_URL=
DOKPLOY_API_KEY=
